{
  "name": "vscode-delete-function",
  "displayName": "Delete Function",
  "description": "quick delete function",
  "version": "1.0.1",
  "publisher": "clovu",
  "engines": {
    "vscode": "^1.72.0"
  },
  "author": "Clover You <hi@clovu.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clovu/vscode-delete-function.git"
  },
  "homepage": "https://github.com/clovu/vscode-delete-function",
  "bugs": "https://github.com/clovu/vscode-delete-function/issues",
  "keywords": [
    "refactor",
    "javascript",
    "typescript",
    "delete function"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:delete-function.deleteFunction"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "delete-function.deleteFunction",
        "category": "DeleteFunction",
        "title": "Delete Function"
      }
    ],
    "keybindings": [
      {
        "command": "delete-function.deleteFunction",
        "key": "ctrl+R F",
        "mac": "cmd+R F"
      }
    ]
  },
  "scripts": {
    "preinstall": "pnpm build:rust",
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc",
    "watch": "tsc -watch",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint .",
    "test": "node ./out/test/runTest.js",
    "test:unit": "vitest --run",
    "build:rust": "pnpm -C packages/rust exec wasm-pack build --target nodejs --scope delete-function --release -d dist --out-name index"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/vscode": "^1.72.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@delete-function/core": "workspace:^"
  }
}
